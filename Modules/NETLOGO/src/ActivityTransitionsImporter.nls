to-report ImportActivityTransitions [file]
  file-close-all
  file-open file
  let header file-read-line
  let counter 1
  let separator ifelse-value (member? "," header) [","][";"]
  let ActTransTempTable []
  foreach n-values (length header) [ i -> i ] [
    i ->
    if item i header = separator [
      set counter counter + 1
    ]
  ]
  while [not file-at-end?] [
    let allFields []
    let tvar file-read-line
    foreach n-values counter [ n -> n ] [
      let cut ifelse-value (position separator tvar != false) [(position separator tvar)] [length tvar]
      let field substring tvar 0 cut
      carefully [
        if is-number? read-from-string field [
          set field read-from-string field
        ]
      ] [
      ]
      set allFields lput field allFields
      if (position separator tvar != false) [
        set tvar substring tvar ((position separator tvar) + 1) length tvar
      ]
    ]
    set ActTransTempTable lput allFields ActTransTempTable
  ]
  file-close-all

  let sexLevels sort remove-duplicates map [ ?1 -> item 0 ?1 ] ActTransTempTable
  let statusLevels sort remove-duplicates map [ ?1 -> item 1 ?1 ] ActTransTempTable
  let dependencyLevels sort remove-duplicates map [ ?1 -> item 2 ?1 ] ActTransTempTable
  let originActivityLevels sort remove-duplicates map [ ?1 -> item 3 ?1 ] ActTransTempTable
  let ageLevels sort remove-duplicates map [ ?1 -> item 4 ?1 ] ActTransTempTable
  
  ;print (word "SEX: " sexLevels)
  ;print (word "STATUS: " statusLevels)
  ;print (word "DEP: " dependencyLevels)
  ;print (word "ACT: " originActivityLevels)
  ;print (word "AGE: " ageLevels)

  let actTransArray []
  foreach dependencyLevels [ tDependencyLevel ->
    let n1Table filter [ i -> item 2 i = tDependencyLevel ] ActTransTempTable
    let ageArray []
    foreach ageLevels [ tAgeLevel ->
      let n2Table filter [ i -> item 4 i = tAgeLevel ] n1Table
      let statusArray []
      foreach statusLevels [ tStatusLevel ->
        let n3Table filter [ i -> item 1 i = tStatusLevel ] n2Table
        let sexArray []
        foreach sexLevels  [ tSexLevel ->
          ;if information? [print tSexLevel]
          let n4Table filter [ i -> item 0 i = tSexLevel ] n3Table
          let activityArray []
          foreach originActivityLevels [ tOriginActivityLevel ->
            ;if information? [print tOriginActivityLevel]
            let n5Table filter [ i -> item 3 i = tOriginActivityLevel ] n4Table
            if not empty? n5Table [
              let probsArray []
              foreach range 2 [ ppart ->
                let transValue item 6 item ppart n5Table
                let destinationActivity item 5 item ppart n5Table
                set probsArray lput (list destinationActivity transValue) probsArray
              ]
              set activityArray lput probsArray activityArray
            ]
          ]
          set sexArray lput activityArray sexArray ;F = 0; M = 1
        ]
        set statusArray lput sexArray statusArray ; B = 0, etc.
      ]
      set ageArray lput statusArray ageArray
    ]
    set actTransArray lput ageArray actTransArray
  ]
  report actTransArray
end