to resetTimer
  set gTimer 0
  reset-timer
end

to showTimer
  set gTimer timer
  print (word "Total time: " gTimer)
end

to showVar [agent]
  ask agent [
    print "who sex age st act dep ego mSt care careS careD nCareS nCareD careEgo carePEgo careOth cByP cByCh cBPar cBBro cBRel"
    print (word t_gender t_age t_status t_dependency t_maritalStatus t_care t_careSupply t_careDemand t_netCareSupply t_netCareDemand t_careGivenToEgo t_careGivenToPartnerEgo t_careGivenToOtherRelatives t_carebyPartner t_carebyChildren t_carebyParents t_carebyBrothers t_carebyRelatives)
  ]
end

to showCompCare [agentEgo]
  ask agentEgo [
  if not t_isEgo [user-message "not ego"]
  computeCare agentEgo false
  print "ego-partnerTheoretical ego-partnerCareAvailable ego-partnerDependency ego-partnerWork ego-partnerOthers"
  print (word item kPartnerHoursLiving t_ego-accounts " " item kPartnerAvailable t_ego-accounts " " item kPartnerDependency t_ego-accounts " " item kPartnerWork t_ego-accounts " " item kPartnerOthers t_ego-accounts)
  ]
end

to-report ageLimited [ageAgent]
  ifelse ageAgent > 105 [
    report 105
  ][
    report ageAgent
  ]
end

to-report interLists [l1 l2]
  report filter [i -> member? i l1] l2
end

to-report getEgo [agentEgo]
  if is-agentset? agentEgo [ set agentEgo one-of agentEgo with [t_isEgo] ]
  report agentEgo
end

to-report countPartner [agent checkActive]
  let agentSet no-turtles

  ask partner-neighbors [
	  ifelse checkActive = kActive [
      if is-active? self [ set agentSet (turtle-set self agentSet) ]
    ][
      ifelse checkActive = kActiveInTheFuture [
        if tickIn > ticks [
          set agentSet (turtle-set self agentSet)
        ]
      ][
        set agentSet (turtle-set self agentSet)
      ]
    ]
  ]
  
  report agentSet
end

to-report getChildrenSet [agent inLaws checkActive]

  let agentSet no-turtles

  ask t_childrenSet [
	  ifelse checkActive = kActive [
      if is-active? self [ set agentSet (turtle-set self agentSet) ]
    ][
      ifelse checkActive = kActiveInTheFuture [
        if tickIn > ticks [
          set agentSet (turtle-set self agentSet)
        ]
      ][
        set agentSet (turtle-set self agentSet)
      ]
    ]
  ]
  
  if (inLaws = kInLaws) or (inLaws = kOnlyInLaws) [
    let agentSetInLaws no-turtles
    ask t_childrenSet [
      ask partner-neighbors [
          ifelse checkActive = kActive [
            if is-active? self [ set agentSetInLaws (turtle-set self agentSetInLaws) ]
          ][
          	ifelse checkActive = kActiveInTheFuture [
          	  if tickIn > ticks [
                set agentSetInLaws (turtle-set self agentSetInLaws)
          	  ]
          	][
              set agentSetInLaws (turtle-set self agentSetInLaws)
          	]
          ]
      ]
    ]
    ifelse inLaws = kInLaws [
      report (turtle-set agentSet agentSetInLaws)
    ][
      report agentSetInLaws
    ]
  ]
  report agentSet
end

to initAgent [agent]
  ; newly created agent
  
  let id 0
  ask agent [
    set id t_idfamily
  ]

  let myEgo actives with [t_idfamily = id and t_isEgo]
  
  initFamily myEgo
end

to initFamily [agentEgo]
  ask agentEgo [
    ask partner-neighbors [
      set t_isPartner true
      if t_kinTypeRelEgo < 0 [print (word "init " self)]
      set t_kinTypeRelEgo kEgoPartner
    ]
    
    let myChildren getChildrenSet self kNoInLaws kInactive
    ask myChildren [
      set t_isChildren true
      set t_kinTypeRelEgo kEgoChild
       ask partner-neighbors [
        set t_isChildrenInLaw true
        set t_kinTypeRelEgo kEgoChildInLaw       
      ]
      let myGrandChildren getChildrenSet self kNoInLaws kInactive
      ask myGrandChildren [
      	set t_isGrandChildren true
      	set t_kinTypeRelEgo kEgoGrandChild
      ]
    ]
  ]
end

to-report listSelect
  let ll []
  let ltemp []
  
  ifelse count actives with [t_isEgo] > 0 [
    ifelse egoDependency = "all" [
      set ll [t_idfamily] of actives with [t_isEgo]
    ][
      set ll [t_idfamily] of actives with [t_isEgo and t_dependency = egoDependency]
    ]
  ][
    report []
  ]

  if partnerEgoDep != "all" [
  	if count actives with [t_isPartner] > 0 [
      set ltemp [t_idfamily] of actives with [t_isPartner and t_dependency = partnerEgoDep]
      set ll (interLists ll ltemp)
    ]
  ]
  
  if inlawDep != "all" [
  	if count actives with [t_isChildrenInLaw] > 0 [
  		set ltemp [t_idfamily] of actives with [t_isChildrenInLaw and t_dependency = inlawDep]
  		set ll (interLists ll ltemp)
  	]
  ]
  
  if childDep [
  	set ltemp [t_idfamily] of actives with [t_childrenNeedCare]
  	set ll (interLists ll ltemp)
  ]
  
  report ll

end

