to-report ImportCare [file]
  file-close-all
  file-open file
  let header file-read-line
  let counter 1
  let separator ifelse-value (member? "," header) [","][";"]
  let careTable []
  foreach n-values (length header) [ i -> i ] [
    i ->
    if item i header = separator [
      set counter counter + 1
    ]
  ]
  
  while [not file-at-end?] [
    let allFields []
    let tvar file-read-line
    foreach n-values counter [ i -> i ] [
      let cut ifelse-value (position separator tvar != false) [(position separator tvar)] [length tvar]
      let field substring tvar 0 cut
      carefully [
        if is-number? read-from-string field [
          set field read-from-string field
        ]
      ] [
      ]
      set allFields lput field allFields
      if (position separator tvar != false) [
        set tvar substring tvar ((position separator tvar) + 1) length tvar
      ]
    ]
    set careTable lput allFields careTable
  ]
  file-close-all

  let tcareArray []
  let ageLevels sort remove-duplicates map [ ?1 -> item 1 ?1 ] CareTable
  let activityLevels sort remove-duplicates map [ ?1 -> item 0 ?1 ] CareTable
  
  ;print (word "AGE: " ageLevels)
  ;print (word "ACTIVITY: " activityLevels)

  foreach ageLevels [
    ageLevel ->
    let fAgeTable filter [ row -> item 1 row = ageLevel ] careTable
    let activityArray []
    foreach activityLevels [
      activityLevel ->
      let fActivityTable filter [ row -> item 0 row = activityLevel ] fAgeTable
      if not empty? fAgeTable [
        let referenceValues sublist (item 0 fActivityTable) 2 6
        set activityArray lput referenceValues activityArray
      ]
    ]
    set tcareArray lput activityArray tcareArray
  ]
  
  set kMaxCare item 0 item 0 item 25 tcareArray

  report tcareArray
end